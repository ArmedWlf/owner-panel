PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tarabar_db
JWT_SECRET=change_this_to_a_long_random_secret

# درگاه پیامک (اختیاری). اگر خالی بماند، کد تأیید فقط در کنسول سرور چاپ می‌شود (حالت توسعه).
# مقدار SMS_PROVIDER را روی kavenegar بگذارید و SMS_API_KEY را از پنل کاوه‌نگار بگیرید.
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE=verify
